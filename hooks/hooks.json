{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/catalog-diff.mjs", "--session-start"],
            "timeout": 15,
            "statusMessage": "qa-my-app: checking drift"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/catalog-diff.mjs", "--silent", "--post-tool"],
            "timeout": 10,
            "async": true,
            "statusMessage": "qa-my-app: drift check"
          }
        ]
      }
    ]
  }
}
